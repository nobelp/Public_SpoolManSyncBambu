# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_token_here

# HA-Entity-Namen (Issue #6). Alles optional: ohne Eintrag gelten die Namen der
# urspruenglichen Installation. Vorschlaege fuer die eigene Installation:
#   docker exec <container> python3 discover_entities.py   (nur lesend, aendert nichts)
# Gemeinsamer Anfang der Drucker-Entities: daraus werden AMS-Slots, externe Spule und
# der Extern-aktiv-Sensor abgeleitet.
# PRINTER_ENTITY_PREFIX=sensor.p2s_<seriennummer>
# Einzeln ueberschreibbar (nur wenn der Name vom abgeleiteten abweicht):
# EXTERNAL_SPOOL_ENTITY=sensor.p2s_<seriennummer>_externalspool_externe_spule
# EXTERNAL_ACTIVE_ENTITY=binary_sensor.p2s_<seriennummer>_externalspool_aktiv
# Pflicht fuer die Verbrauchsbuchung:
# PRINT_STATUS_ENTITY=sensor.<anzeigename>_druckstatus
# PRINT_PROGRESS_ENTITY=sensor.<anzeigename>_druckfortschritt
# PRINT_WEIGHT_ENTITY=sensor.<anzeigename>_gewicht_des_drucks
# Optional (ohne sie fehlen nur Zusatzfunktionen):
# GCODE_ENTITY=sensor.<anzeigename>_gcode_dateiname
# STARTTIME_ENTITY=sensor.<anzeigename>_startzeit
# TASK_NAME_ENTITY=sensor.<anzeigename>_name_der_aufgabe
# TITLE_IMAGE_ENTITY=image.<anzeigename>_titelbild
# LIVE_CAMERA_ENTITY=camera.<anzeigename>_kamera
# PLATE_TYPE_ENTITY=sensor.<anzeigename>_druckbett_typ

# Spoolman
SPOOLMAN_URL=http://spoolman.local:7912

# Job 1 - Registrierung (sync.py)
POLL_INTERVAL=60
STATE_FILE=/app/data/state.json
LOG_FILE=/app/logs/sync.log
# Vollabgleich Location (entnommene Spulen -> 'Lager') alle X Sekunden
RECONCILE_INTERVAL_SECONDS=900

# Job 2 - Verbrauch (consumption.py)
CONSUMPTION_INTERVAL=60
CONSUMPTION_STATE_FILE=/app/data/consumption_state.json
CONSUMPTION_LOG_FILE=/app/logs/consumption.log
# Mindest-Abzug in Gramm bevor gepatcht wird (API-Schonung)
MIN_DEDUCT_G=0.5
# RUN_ONCE=1 -> einmalig laufen (fuer DSM-Aufgabenplaner statt Dauerbetrieb)
RUN_ONCE=0
# Druckverlauf (Bild, Farbe/Verbrauch, editierbarer Name)
CONSUMPTION_HISTORY_FILE=/app/data/print_history.json
CONSUMPTION_HISTORY_IMAGES_DIR=/app/data/history_images
# 0 (Standard) = unbegrenzt aufbewahren; bei Bedarf auf eine feste Zahl setzen
CONSUMPTION_HISTORY_MAX_RECORDS=0
# Port der Druckverlauf-Webseite (siehe docker-compose.yml ports:)
CONSUMPTION_HISTORY_WEB_PORT=8100
# Oeffentliche Spoolman-Adresse fuer Links im Browser (z.B. /nachkaufen -> "Link eintragen")
SPOOLMAN_PUBLIC_URL=https://spoolman.example.com
# Nachkaufen/Preisvergleich (/nachkaufen): Standard-Schwelle Gesamtbestand in %
RESTOCK_THRESHOLD_PCT=20
# Preis-Cache (Stunden) und Datei
PRICE_CACHE_TTL_H=12
PRICE_CACHE_FILE=/app/data/price_cache.json
# EUR->CHF-Fallback, falls der EZB-Tageskurs nicht abrufbar ist
EUR_CHF_FALLBACK=0.94
# Oeffentliche Adresse dieses Dienstes fuer das Galaxus-Lesezeichen (ohne: aus dem Host-Header)
NACHKAUFEN_PUBLIC_URL=https://history.example.com
# Shop-Links Bambu Lab/CCTREE automatisch ueber die ColorID ergaenzen (Intervall in Stunden, Zustandsdatei)
SHOP_LINKS_INTERVAL_H=6
SHOP_LINKS_STATE_FILE=/app/data/shop_links_state.json
# Optional: fester Schluessel fuer das Lesezeichen (ohne: einmalig zufaellig erzeugt, in data/price_cache.json)
# RESTOCK_BOOKMARKLET_TOKEN=

# Job 3 - Filament-Anreicherung (filament_enrich.py)
FILAMENT_ENRICH_INTERVAL=30
FILAMENT_ENRICH_STATE_FILE=/app/data/filament_enrich_state.json
FILAMENT_ENRICH_LOG_FILE=/app/logs/filament_enrich.log
# Port des Web-Formulars fuer Volltext-Import (siehe docker-compose.yml ports:)
FILAMENT_ENRICH_WEB_PORT=8099
# Max. Groesse des eingefuegten Produkttexts in Bytes
FILAMENT_ENRICH_MAX_PASTE_BYTES=200000
# Bambu-Cloud-Namen (Issue #50): Token wird NICHT hier, sondern ueber /cloud-token eingetragen
# BAMBU_CLOUD_TOKEN_FILE=/app/data/bambu_cloud_token
# BAMBU_CLOUD_NAMES_INTERVAL_S=900
# BAMBU_CLOUD_NAMES_MAX_AGE_DAYS=14
